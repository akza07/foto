<?xml version="1.0" encoding="utf-8"?><!--
   Full backup rules (API ≤ 30). Excludes the thumbnail caches and animated
   video-frame cache from auto-backup — they're private previews that
   regenerate automatically.
-->
<full-backup-content>
    <exclude domain="file" path="frames/"/>
    <exclude domain="file" path="image_cache/"/>
    <exclude domain="file" path="thumb_cache/"/>
</full-backup-content>
