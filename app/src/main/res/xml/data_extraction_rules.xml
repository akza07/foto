<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+).
   Excludes the thumbnail caches and animated video-frame cache from cloud
   backup and device-to-device transfer — they're private previews that
   regenerate automatically.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="frames/"/>
        <exclude domain="file" path="image_cache/"/>
        <exclude domain="file" path="thumb_cache/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="frames/"/>
        <exclude domain="file" path="image_cache/"/>
        <exclude domain="file" path="thumb_cache/"/>
    </device-transfer>
</data-extraction-rules>
