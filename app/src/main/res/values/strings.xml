    <!-- First-run tutorial -->
    <string name="tutorial_welcome_title">Welcome to Foto</string>
    <string name="tutorial_welcome_body">A fast, AMOLED-first gallery for the photos and videos already on your device.</string>
    <string name="tutorial_browse_title">Find your photos</string>
    <string name="tutorial_browse_body">Open an album to see everything inside, or tap the search icon to find a photo by name, camera, date or place.</string>
    <string name="tutorial_viewer_title">View and zoom</string>
    <string name="tutorial_viewer_body">Swipe between photos, double-tap or pinch to zoom, and swipe down to close.</string>
    <string name="tutorial_actions_title">Actions in one motion</string>
    <string name="tutorial_actions_body">Long-press anywhere, slide to Delete, Info, Share, Crop or Wallpaper, then release to run it.</string>
    <string name="tutorial_safety_title">Select and stay safe</string>
